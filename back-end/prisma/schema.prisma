generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  birthDate     DateTime?
  passwordHash  String
  role          Role           @default(CLIENT)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  appointments  Appointment[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  @@index([userId])
}

model Professional {
  id             String                @id @default(cuid())
  userId         String?               @unique
  name           String
  slug           String                @unique
  bio            String?
  specialty      String?
  photoUrl       String?
  whatsappNumber String?
  active         Boolean               @default(true)
  bufferMinutes  Int                   @default(0)
  services       ProfessionalService[]
  schedules      ProfessionalSchedule[]
  breaks         ProfessionalBreak[]
  blockedPeriods BlockedPeriod[]
  appointments   Appointment[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Service {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  description   String
  durationMin   Int
  priceCents    Int
  icon          String?
  active        Boolean               @default(true)
  featured      Boolean               @default(false)
  sortOrder     Int                   @default(0)
  professionals ProfessionalService[]
  appointments  AppointmentService[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([professionalId, serviceId])
}

model ProfessionalSchedule {
  id             String       @id @default(cuid())
  professionalId String
  weekday        Int
  startMinute    Int
  endMinute      Int
  active         Boolean      @default(true)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  @@unique([professionalId, weekday, startMinute, endMinute])
}

model ProfessionalBreak {
  id             String       @id @default(cuid())
  professionalId String
  weekday        Int
  startMinute    Int
  endMinute      Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model BlockedPeriod {
  id             String       @id @default(cuid())
  professionalId String
  startAt        DateTime
  endAt          DateTime
  reason         String?
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  @@index([professionalId, startAt, endAt])
}

model Appointment {
  id            String              @id @default(cuid())
  code          String              @unique
  clientId      String?
  professionalId String
  startAt       DateTime
  endAt         DateTime
  timezone      String
  subtotalCents Int
  totalCents    Int
  status        AppointmentStatus   @default(CONFIRMED)
  customerName  String
  customerPhone String
  customerEmail String?
  notes         String?
  cancelledAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  client        User?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  professional  Professional        @relation(fields: [professionalId], references: [id])
  services      AppointmentService[]
  @@index([professionalId, startAt, endAt])
  @@index([clientId, startAt])
}

model AppointmentService {
  appointmentId String
  serviceId     String
  nameSnapshot  String
  priceCents    Int
  durationMin   Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])
  @@id([appointmentId, serviceId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String
  category  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessSetting {
  id        String   @id @default("default")
  name      String   @default("Los Pit Barber Shop")
  address   String?
  phone     String?
  email     String?
  instagram String?
  openingHours Json?
  cancellationHours Int @default(2)
  minimumNoticeMin Int @default(60)
  maximumAdvanceDays Int @default(60)
  timezone  String   @default("America/Fortaleza")
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
}
